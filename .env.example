# ==========================================
# CashMind AI Service — Environment Config
# ==========================================

# Server Settings
PORT=9102
HOST=0.0.0.0
DEBUG=false
SERVICE_NAME=cashmind
API_PREFIX=/api/v1

# Internal Service Authentication (Shared secret between CashMod and CashMind)
# Leave empty in local development to bypass auth check
CASHMIND_API_KEY=

# Groq API Configuration (Exclusively used for LLM inference)
# Can provide a single key or comma-separated pool: "gsk_key1,gsk_key2,gsk_key3"
GROQ_API_KEYS=your_groq_api_key_here

# Model Selection Routing (available on your Groq plan)
GROQ_MODEL_MODERATION=openai/gpt-oss-20b
GROQ_MODEL_ANNOUNCEMENT_GEN=openai/gpt-oss-120b
GROQ_MODEL_ANNOUNCEMENT_REW=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Concurrency & Resilience
GROQ_MAX_CONCURRENCY=10
GROQ_REQUEST_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=3
KEY_COOLDOWN_SECONDS=60.0
